{
  "name": "keyarc-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["*/5 * * * *"] },
  "kv_namespaces": [{ "binding": "AGENT_KV", "id": "REPLACE_WITH_KV_ID" }],
  "vars": {
    "CHESTS": "",
    "ALLOWED_ORIGINS": "https://keyarc.pages.dev,https://keyarc.app,http://localhost:5180"
  },
  "observability": { "enabled": true }
}
